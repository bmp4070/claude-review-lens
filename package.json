{
  "name": "claude-review-lens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/claude-review-code"
  },
  "displayName": "Claude Review Lens",
  "description": "Visualize AI code review comments as native VS Code comment threads - like CodeRabbit for local development",
  "version": "0.5.0",
  "publisher": "code-authx",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "claude",
    "ai",
    "code review",
    "comments",
    "pr review"
  ],
  "activationEvents": [
    "workspaceContains:.claude-review.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-review.refresh",
        "title": "Refresh Review Comments",
        "category": "Claude Review",
        "icon": "$(refresh)"
      },
      {
        "command": "claude-review.resolve",
        "title": "Resolve",
        "category": "Claude Review",
        "icon": "$(check)"
      },
      {
        "command": "claude-review.resolveAll",
        "title": "Resolve All Comments",
        "category": "Claude Review",
        "icon": "$(check-all)"
      },
      {
        "command": "claude-review.openPanel",
        "title": "Open Comments Panel",
        "category": "Claude Review",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claude-review.expandAll",
        "title": "Expand All Comments",
        "category": "Claude Review",
        "icon": "$(expand-all)"
      },
      {
        "command": "claude-review.toggleAtLine",
        "title": "Toggle Comment at Line",
        "category": "Claude Review",
        "icon": "$(comment)"
      },
      {
        "command": "claude-review.applySuggestion",
        "title": "Apply Suggestion",
        "category": "Claude Review",
        "icon": "$(play)"
      },
      {
        "command": "claude-review.copySuggestion",
        "title": "Copy Suggestion",
        "category": "Claude Review",
        "icon": "$(copy)"
      },
      {
        "command": "claude-review.reply",
        "title": "Reply to Claude",
        "category": "Claude Review",
        "icon": "$(comment)"
      },
      {
        "command": "claude-review.checkCliStatus",
        "title": "Check Claude CLI Status",
        "category": "Claude Review",
        "icon": "$(debug-console)"
      }
    ],
    "configuration": {
      "title": "Claude Review",
      "properties": {
        "claudeReview.claudeCliPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to Claude CLI executable (leave empty to auto-detect)"
        },
        "claudeReview.replyTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 300,
          "description": "Timeout in seconds for Claude CLI responses"
        }
      }
    },
    "keybindings": [
      {
        "command": "claude-review.toggleAtLine",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "claude-review.resolve",
          "when": "commentController == claude-review",
          "group": "inline"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "claude-review.reply",
          "when": "commentController == claude-review",
          "group": "inline@1"
        },
        {
          "command": "claude-review.resolve",
          "when": "commentController == claude-review",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "claude-review.applySuggestion",
          "when": "commentController == claude-review && comment == suggestion",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "claude-review.refresh",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "claude-review.resolveAll",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "claude-review.openPanel",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "claude-review.expandAll",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "claude-review.toggleAtLine",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vsce": "^2.15.0"
  }
}
